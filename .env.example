# Active Backend API URLs
# API root endpoint used across product services, MongoDB images, etc.
VITE_API_URL=http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000

# Payment Gateway Configuration
VITE_RAZORPAY_KEY_ID="rzp_test_your_razorpay_key"

# Environment Reference URLs (Switch VITE_API_URL / VITE_API_BASE_URL to these when deploying)
# Production (Render Backend):
# VITE_API_URL=https://lmart-server-5lx6.onrender.com/api
# Set this to the actual deployed backend URL in the hosting environment.
# VITE_API_BASE_URL=https://lmart-server-5lx6.onrender.com
# Local Development:
# VITE_API_URL=http://localhost:5000/api
# VITE_API_BASE_URL=http://localhost:5000
